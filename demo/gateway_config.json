{
  "client_id_header": "X-Client-Id",
  "rate_limit": {"requests_per_second": 5, "max_concurrent": 3},
  "routes": [
    {
      "id": "users",
      "path_prefix": "/users",
      "lb_strategy": "round_robin",
      "failure_threshold": 3,
      "probe_interval": 1.0,
      "probe_path": "/healthz",
      "circuit_threshold": 4,
      "circuit_open_seconds": 2.0,
      "timeout_seconds": 0.8,
      "max_retries": 1,
      "retry_on_status": [502, 503, 504],
      "upstreams": [
        {"id": "users-1", "base_url": "http://127.0.0.1:18081", "weight": 1},
        {"id": "users-2", "base_url": "http://127.0.0.1:18082", "weight": 1}
      ]
    },
    {
      "id": "orders",
      "path_prefix": "/orders",
      "lb_strategy": "weighted_round_robin",
      "upstreams": [
        {"id": "orders-1", "base_url": "http://127.0.0.1:18091", "weight": 3}
      ]
    }
  ]
}
